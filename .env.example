# Database Configuration
# ========================

# Option 1: SQLite (Development - Default)
# Stores data in local file, perfect for testing
DATABASE_URL=sqlite+aiosqlite:///./gstagent.db

# Option 2: PostgreSQL (Production - Recommended)
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/gstagent
# Example with Railway:
# DATABASE_URL=postgresql+asyncpg://user:password@containers-us-west-12.railway.app:5432/railway

# API Server Configuration
API_PORT=8000
API_HOST=0.0.0.0

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "https://gstagent.co.in"]

# Logging
SQL_ECHO=0
LOG_LEVEL=INFO

# Feature Flags
ENABLE_PAYMENT_TRACKING=true
ENABLE_GST_FILING=true
ENABLE_RECONCILIATION=true
