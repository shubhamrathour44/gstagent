# Copy this to .env for local development
# On Railway, set these in the Variables tab — never commit .env to GitHub

ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
JWT_SECRET_KEY=change-this-to-a-random-32-character-string
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gstagent
ENVIRONMENT=production
DOMAIN=gstagent.co.in

# Razorpay (add after Razorpay account approved)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Email (optional - for sending vendor emails)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_USER=
SMTP_PASSWORD=
