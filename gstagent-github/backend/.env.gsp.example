# GSTAgent GSP connector settings
# Default safe mode: mock. Use this for demos without real GST portal access.
GSP_PROVIDER=mock

# After ASP/GSP onboarding, switch provider, for example:
# GSP_PROVIDER=mastergst
# MASTERGST_BASE_URL=https://api.your-gsp-sandbox.example
# MASTERGST_API_KEY=replace-with-gsp-api-key
# MASTERGST_API_SECRET=replace-with-gsp-secret-if-required
# MASTERGST_VERIFY_PATH=/gstin/verify/{gstin}
# MASTERGST_GSTR2B_PATH=/returns/gstr2b?gstin={gstin}&ret_period={period}
# MASTERGST_GSTR1_PATH=/returns/gstr1?gstin={gstin}&ret_period={period}
# MASTERGST_FILING_STATUS_PATH=/returns/status?gstin={gstin}&ret_period={period}&return_type={return_type}

# WhiteBooks example placeholders. Replace with exact paths from your GSP docs.
# GSP_PROVIDER=whitebooks
# WHITEBOOKS_BASE_URL=https://api.whitebooks.in
# WHITEBOOKS_API_KEY=replace-with-api-key
# WHITEBOOKS_API_SECRET=replace-with-secret
# WHITEBOOKS_VERIFY_PATH=/gstin/{gstin}
# WHITEBOOKS_GSTR2B_PATH=/gstr2b/{gstin}/{period}
# WHITEBOOKS_GSTR1_PATH=/gstr1/{gstin}/{period}
# WHITEBOOKS_FILING_STATUS_PATH=/filing-status/{gstin}/{period}/{return_type}
